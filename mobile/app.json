{
  "expo": {
    "name": "FinTrack",
    "slug": "fintrack",
    "version": "1.0.0",
    "scheme": "fintrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.subinps.fintrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "in.subinps.fintrack",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0200b7e7-dd74-47e2-a2a7-202284c252e7"
      }
    },
    "owner": "subinps",
    "plugins": [
      "./plugins/withAndroidAllowBackup",
      "./plugins/withAndroidRemoveBundleCompression",
      "./plugins/withAndroidForceCoreKtx",
      "./plugins/withAndroidPickFirst",
      "./plugins/withAndroidSplits",
      "./plugins/withAndroidSigning",
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "./plugins/withAndroidNotificationListener",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0200b7e7-dd74-47e2-a2a7-202284c252e7"
    }
  }
}